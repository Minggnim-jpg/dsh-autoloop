{
  "name": "dsh-autoloop",
  "version": "0.2.1",
  "description": "DeepSeek Harness (dsh) plugin for Agent Autoloop: a sidebar panel to watch runs, answer cards waiting on you, browse history, edit scheduled rules and manage the local hub.",
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Minggnim-jpg",
    "url": "https://github.com/Minggnim-jpg"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Minggnim-jpg/dsh-autoloop.git"
  },
  "homepage": "https://github.com/Minggnim-jpg/dsh-autoloop#readme",
  "bugs": {
    "url": "https://github.com/Minggnim-jpg/dsh-autoloop/issues"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "cordis.patch.yml",
    "README.md",
    "CHANGELOG.md",
    "NOTICE",
    "VERSION",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 || 0.2.2-rc.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/*.test.mjs",
    "release": "node scripts/release.mjs",
    "traffic": "node scripts/collect-traffic.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "cordis",
    "agent-autoloop",
    "autoloop",
    "automation",
    "task-automation",
    "ai-agent",
    "agent-orchestration",
    "scheduler",
    "cron",
    "human-in-the-loop",
    "approval",
    "dashboard",
    "skeuomorphic",
    "panel",
    "web"
  ]
}
