#!/bin/sh
# 提交前检查：拦截常见的个人信息泄露。
#
# 安装：cp scripts/pre-commit.sample .git/hooks/pre-commit && chmod +x .git/hooks/pre-commit
# 或直接执行 scripts/install-hooks.sh

STAGED=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$STAGED" ] && exit 0

FAIL=0

check() {
  desc=$1
  pattern=$2
  hits=$(echo "$STAGED" | while read -r f; do
    [ -f "$f" ] && grep -nEI "$pattern" "$f" 2>/dev/null | sed "s|^|$f:|"
  done)
  if [ -n "$hits" ]; then
    echo "✗ $desc"
    echo "$hits" | head -5 | sed 's/^/    /'
    FAIL=1
  fi
}

echo "→ 检查个人信息与凭证..."

check "疑似真实邮箱（应使用 noreply）" \
  '[a-zA-Z0-9._%+-]+@(gmail|qq|163|126|outlook|hotmail|icloud|foxmail|yahoo)\.[a-zA-Z.]+'

check "含用户名的绝对路径" \
  '/Users/[a-zA-Z][a-zA-Z0-9_-]+/|/home/[a-zA-Z][a-zA-Z0-9_-]+/'

check "疑似 API Key / Token" \
  'sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{20,}|gho_[a-zA-Z0-9]{20,}|github_pat_[a-zA-Z0-9_]{20,}|AKIA[0-9A-Z]{16}'

check "疑似手机号" \
  '(^|[^0-9])1[3-9][0-9]{9}([^0-9]|$)'

check "疑似 Discord / 长数字通道 ID" \
  '[0-9]{17,20}'

if [ "$FAIL" = "1" ]; then
  echo ""
  echo "提交已阻止。确认后如仍需提交，用 git commit --no-verify 跳过。"
  exit 1
fi

echo "✓ 未发现明显泄露"
exit 0
